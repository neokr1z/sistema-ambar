<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AMBAR.Semana4</AssemblyName>
    <RootNamespace>AMBAR.Semana4</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="QuestPDF" Version="2024.3.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="EVIDENCIAS_SEMANA4.md" />
    <None Remove="README.md" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="CambiarPasswordForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="CambiarPasswordForm.Designer.cs"><DependentUpon>CambiarPasswordForm.cs</DependentUpon></Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="CambiarPasswordForm.resx"><DependentUpon>CambiarPasswordForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ConsultaDForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ConsultaDForm.Designer.cs"><DependentUpon>ConsultaDForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="ConsultaDForm.resx"><DependentUpon>ConsultaDForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ExpedienteMForm.cs" />
    <Compile Update="ExpedienteMForm.Designer.cs"><DependentUpon>ExpedienteMForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="ExpedienteMForm.resx"><DependentUpon>ExpedienteMForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="InscripcionForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="InscripcionForm.Designer.cs"><DependentUpon>InscripcionForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="InscripcionForm.resx"><DependentUpon>InscripcionForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="HistorialdocForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="HistorialdocForm.Designer.cs"><DependentUpon>HistorialdocForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="HistorialdocForm.resx"><DependentUpon>HistorialdocForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="CapturaCLForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="CapturaCLForm.Designer.cs"><DependentUpon>CapturaCLForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="CapturaCLForm.resx"><DependentUpon>CapturaCLForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="LoginForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="LoginForm.Designer.cs"><DependentUpon>LoginForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="LoginForm.resx"><DependentUpon>LoginForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ConsultaA.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ConsultaA.Designer.cs"><DependentUpon>ConsultaA.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="ConsultaA.resx"><DependentUpon>ConsultaA.cs</DependentUpon></EmbeddedResource>
    <Compile Update="UsuariosForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="UsuariosForm.Designer.cs"><DependentUpon>UsuariosForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="UsuariosForm.resx"><DependentUpon>UsuariosForm.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>