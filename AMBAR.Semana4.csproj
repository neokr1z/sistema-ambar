<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AMBAR.Semana4</AssemblyName>
    <RootNamespace>AMBAR.Semana4</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="QuestPDF" Version="2024.3.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="ChangePasswordForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ChangePasswordForm.Designer.cs"><DependentUpon>ChangePasswordForm.cs</DependentUpon></Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ChangePasswordForm.resx"><DependentUpon>ChangePasswordForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="DetailForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="DetailForm.Designer.cs"><DependentUpon>DetailForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="DetailForm.resx"><DependentUpon>DetailForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="EditStudentForm.cs" />
    <Compile Update="EditStudentForm.Designer.cs"><DependentUpon>EditStudentForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="EditStudentForm.resx"><DependentUpon>EditStudentForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="EnrollmentForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="EnrollmentForm.Designer.cs"><DependentUpon>EnrollmentForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="EnrollmentForm.resx"><DependentUpon>EnrollmentForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="GradeHistoryForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="GradeHistoryForm.Designer.cs"><DependentUpon>GradeHistoryForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="GradeHistoryForm.resx"><DependentUpon>GradeHistoryForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="GradesForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="GradesForm.Designer.cs"><DependentUpon>GradesForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="GradesForm.resx"><DependentUpon>GradesForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="LoginForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="LoginForm.Designer.cs"><DependentUpon>LoginForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="LoginForm.resx"><DependentUpon>LoginForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="StudentsForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="StudentsForm.Designer.cs"><DependentUpon>StudentsForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="StudentsForm.resx"><DependentUpon>StudentsForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="UsersForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="UsersForm.Designer.cs"><DependentUpon>UsersForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="UsersForm.resx"><DependentUpon>UsersForm.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>
